{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/**,dist/ssr-template.html,dist/admin.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
